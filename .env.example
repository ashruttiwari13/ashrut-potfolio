# ==============================================================================
# ASHRUT TIWARI - PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in the values below from your Supabase and Resend dashboards.

# ------------------------------------------------------------------------------
# 1. PUBLIC SITE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings -> API -> Project API keys -> 'anon' / 'public' key
# (Safe for browser / client usage with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Project Settings -> API -> Project API keys -> 'service_role' key
# (SERVER-ONLY - Never expose to browser! Used for admin mutations and setup)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. RESEND EMAIL API (https://resend.com)
# ------------------------------------------------------------------------------
# API Keys -> Create API Key (e.g. re_123456789)
RESEND_API_KEY=re_your_api_key_here

# The verified sending email address (e.g., inquiries@ashrut.dev or on onboarding: onboarding@resend.dev)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# The email where freelance inquiries will be delivered
CONTACT_TO_EMAIL=ashrut.tiwari2004@gmail.com

# ------------------------------------------------------------------------------
# 4. ADMIN DASHBOARD FALLBACK PASSCODE (Optional fallback for quick local testing)
# ------------------------------------------------------------------------------
# A strong secret passkey to access the /admin dashboard locally before Supabase Auth is configured
ADMIN_SECRET_KEY=change-this-to-a-very-strong-secret-in-production
